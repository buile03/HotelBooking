@using DPKS.App.Extensions
@using DPKS.Common.Helper
@using DPKS.Common.Result

@model PagedResult<DPKS.Model.Phong.ThongTinDanhSachPhongVm>

<div class="card shadow-sm rounded-3 border-0">
    

    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-bordered table-hover table-striped mb-0 text-center align-middle">
                <thead class="bg-light text-dark border-bottom">
                    <tr>
                        <th>Số phòng</th>
                        <th>Loại phòng</th>
                        <th>Giá (đ/đêm)</th>
                        <th>Giường</th>
                        <th>View</th>
                        <th>Trạng thái</th>
                        <th>Chức năng</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Items != null && Model.Items.Any())
                    {
                        foreach (var p in Model.Items)
                        {
                            <tr>
                                <td>@p.SoPhong</td>
                                <td>@p.Type</td>
                                <td>@p.Gia.ToString("N0")</td>
                                <td>@enHelper.GetDescription(p.LoaiGiuong)</td>
                                <td>@enHelper.GetDescription(p.LoaiView)</td>
                                <td>
                                    <span class="badge text-dark">
                                        @enHelper.GetDescription(p.TrangThaiPhong)
                                    </span>
                                </td>
                                <td>
                                    <a title="Sửa phòng"
                                       class="btn btn-sm btn-outline-primary popup mr-1"
                                       data-toggle="modal"
                                       data-target="#modal"
                                       data-url="/Phong/Edit/?id=@p.PhongId"
                                       data-link="@Context.Request.GetRawUrl()">
                                        <i class="fa fa-edit"></i>
                                    </a>

                                    <button type="button"
                                            class="btn btn-sm btn-outline-danger btn-delete"
                                            data-id="@p.PhongId.EncodeId1()"
                                            data-token="@Html.GetAntiXsrfRequestToken()">
                                        <i class="fa fa-trash"></i>
                                    </button>
                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-muted">Không có dữ liệu phòng</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @if (Model.TotalRecords > Model.PageSize)
    {
        <div class="card-footer bg-light">
            @await Component.InvokeAsync("Paging", new { page = Model })
        </div>
    }
</div>


<script>
    function handleErrorOrder(elem, data) {
        $(elem).val(data.resultObj)
    }

    $(".txtOrder").on("change", function () {
        updateData($(this).data("url"), $(this).data("id"), $(this).val(), handleErrorOrder, this);
    });
    $(".chStatus").on("change", function () {
        updateData($(this).data("url"), $(this).data("id"));
    });
    
    
                  $(".btn-delete").on("click", function () {
        const id = $(this).data("id");
        const token = $(this).data("token");

        Swal.fire({
            title: 'Xác nhận xóa',
            text: 'Bạn có chắc chắn muốn xóa phòng này không?',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonText: 'Xóa',
            cancelButtonText: 'Hủy'
        }).then((result) => {
            if (result.isConfirmed) {
                $.post("/Phong/Delete", {
                    Id: id,
                    __RequestVerificationToken: token
                }, function (res) {
                    if (res.isSuccessed) { 
                        Swal.fire({
                            title: "Đã xóa!",
                            text: res.message,
                            icon: "success"
                        });
                        loadContent("/Phong", $("#box-content"));
                    } else {
                        Swal.fire({
                            title: "Lỗi",
                            text: res.message,
                            icon: "error"
                        });
                    }
                }).fail(() => {
                    Swal.fire({
                        title: "Lỗi",
                        text: "Không thể xóa do lỗi máy chủ.",
                        icon: "error"
                    });
                });
            }
        });
    });
</script>

