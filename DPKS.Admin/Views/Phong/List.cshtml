    //                 if (result.isConfirmed) {
    //         // Gán id vào input hidden trong form
    //         $('#modal-form-delete input[name="Id"]').val(id);

    //         // Gọi hàm xóa
    //         DeleteData(url, function () {
    //             loadContent(urlCallBack, $('#box-content'));
    //         });
    //     }
    //         });
    //     });
                  $(".btn-delete").on("click", function () {
        const id = $(this).data("id");
        const token = $(this).data("token");

        Swal.fire({
            title: 'Xác nhận xóa',
            text: 'Bạn có chắc chắn muốn xóa phòng này không?',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonText: 'Xóa',
            cancelButtonText: 'Hủy'
        }).then((result) => {
            if (result.isConfirmed) {
                $.post("/Phong/Delete", {
                    Id: id,
                    __RequestVerificationToken: token
                }, function (res) {
                    if (res.isSuccessed) { 
                        Swal.fire({
                            title: "Đã xóa!",
                            text: res.message,
                            icon: "success"
                        });
                        loadContent("/Phong", $("#box-content"));
                    } else {
                        Swal.fire({
                            title: "Lỗi",
                            text: res.message,
                            icon: "error"
                        });
                    }
                }).fail(() => {
                    Swal.fire({
                        title: "Lỗi",
                        text: "Không thể xóa do lỗi máy chủ.",
                        icon: "error"
                    });
                });
            }
        });
    });
</script>
