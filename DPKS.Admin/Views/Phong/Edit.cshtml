@using DPKS.Common.Enum
@model DPKS.Model.Phong.Request.PhongUpdateRequest

<div class="modal-content">
    <form id="modal-form" enctype="multipart/form-data">
        <div class="modal-header">
            <h4 class="modal-title">Cập nhật phòng</h4>
            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>

        <div class="modal-body">
            <div class="form-row">
                <div class="form-group col-md-6">
                    <label asp-for="SoPhong" class="control-label"></label>
                    <input asp-for="SoPhong" class="form-control" />
                    <span asp-validation-for="SoPhong" class="text-danger"></span>
                </div>

                <div class="form-group col-md-6">
                    <label asp-for="Gia" class="control-label"></label>
                    <input asp-for="Gia" class="form-control" />
                    <span asp-validation-for="Gia" class="text-danger"></span>
                </div>

                <div class="form-group col-md-6">
                    <label asp-for="loaiGiuong" class="control-label">Loại giường</label>
                    <select asp-for="loaiGiuong" asp-items="enHelper.GetSelectListLoaiGiuong()" class="form-control" required>
                        <option value="">-- Chọn --</option>
                    </select>
                </div>

                <div class="form-group col-md-6">
                    <label asp-for="loaiView" class="control-label">Loại view</label>
                    <select asp-for="loaiView" asp-items="enHelper.GetSelectListLoaiView()" class="form-control" required>
                        <option value="">-- Chọn --</option>
                    </select>
                </div>

                <div class="form-group col-md-6">
                    <label asp-for="LoaiPhongId" class="control-label">Loại phòng</label>
                    <select asp-for="LoaiPhongId" asp-items="ViewBag.LoaiPhongItems" class="form-control" required>
                        <option value="">-- Chọn --</option>
                    </select>
                </div>

                <div class="form-group col-md-6">
                    <label asp-for="TrangThaiPhongId" class="control-label">Trạng thái</label>
                    <select asp-for="TrangThaiPhongId" asp-items="ViewBag.TrangThaiPhongItems" class="form-control" required>
                        <option value="">-- Chọn --</option>
                    </select>
                </div>

                <div class="form-group col-md-6">
                    <label asp-for="SoNguoiLonToiDa" class="control-label"></label>
                    <input asp-for="SoNguoiLonToiDa" class="form-control" />
                </div>

                <div class="form-group col-md-6">
                    <label asp-for="SoTreEmToiDa" class="control-label"></label>
                    <input asp-for="SoTreEmToiDa" class="form-control" />
                </div>
            </div>
        </div>

        <div class="modal-footer">
            @Html.AntiForgeryToken()

            @if (!string.IsNullOrEmpty(Model.Id))
            {
                <input type="hidden" name="Id" value="@Model.Id" />
            }
            else
            {
                <input type="hidden" name="Id" value="@ViewBag.PhongId?.ToString().EncodeId()" />
            }

            <button type="button" class="btn btn-secondary" data-dismiss="modal">Đóng</button>
            <button type="submit" class="btn btn-primary">Lưu</button>
        </div>
    </form>

    @{
        await Html.RenderPartialAsync("_ModalScript", new DPKS.Admin.Models.ModalFormRequest
            {
                FormId = "modal-form",
                UrlSubmit = "/Phong/Edit",
                UrlPathLoadData = "/Phong/List/",
                LoadDataId = "box-content"
            });
    }
</div>
