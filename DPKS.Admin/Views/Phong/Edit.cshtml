@using DPKS.Common.Enum
@model DPKS.Model.Phong.Request.PhongUpdateRequest

<div class="modal-content">
    <form id="modal-form" enctype="multipart/form-data">
        <div class="modal-header">
            <h4 class="modal-title">Sửa thông tin phòng</h4>
            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>

        <div class="modal-body">
            <div class="form-group">
                <label asp-for="SoPhong"></label><span class="text-danger">*</span>
                <input asp-for="SoPhong" class="form-control" />
                <span asp-validation-for="SoPhong" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Gia"></label>
                <input asp-for="Gia" class="form-control" />
            </div>

            <div class="form-group">
                <label asp-for="loaiGiuong" class="control-label">Loại giường</label>
                <select asp-for="loaiGiuong" asp-items="Html.GetEnumSelectList<enLoaiGiuong>()" class="form-control">
                    <option value="">-- Chọn loại giường --</option>
                </select>
                <span asp-validation-for="loaiGiuong" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="loaiView" class="control-label">Loại view</label>
                <select asp-for="loaiView" asp-items="Html.GetEnumSelectList<enLoaiView>()" class="form-control">
                    <option value="">-- Chọn loại view --</option>
                </select>
                <span asp-validation-for="loaiView" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="LoaiPhongId" class="control-label">Loại phòng</label>
                <select asp-for="LoaiPhongId" asp-items="@ViewBag.LoaiPhongItems" class="form-control">
                    <option value="">-- Chọn loại phòng --</option>
                </select>
                <span asp-validation-for="LoaiPhongId" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="TrangThaiPhongId" class="control-label">Trạng thái</label>
                <select asp-for="TrangThaiPhongId" asp-items="@ViewBag.TrangThaiPhongItems" class="form-control">
                    <option value="">-- Chọn trạng thái --</option>
                </select>
                <span asp-validation-for="TrangThaiPhongId" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="SoNguoiLonToiDa"></label>
                <input asp-for="SoNguoiLonToiDa" class="form-control" />
            </div>

            <div class="form-group">
                <label asp-for="SoTreEmToiDa"></label>
                <input asp-for="SoTreEmToiDa" class="form-control" />
            </div>
        </div>

        <div class="modal-footer">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <button type="button" class="btn btn-secondary" data-dismiss="modal">Đóng</button>
            <button type="submit" class="btn btn-primary">Lưu</button>
        </div>
    </form>

    @{
        await Html.RenderPartialAsync("_ModalScript",
        new DPKS.Admin.Models.ModalFormRequest()
            {
                FormId = "modal-form",
                UrlSubmit = "/Phong/Edit",
                UrlPathLoadData = Context.Request.Query["resultUrl"],
                LoadDataId = "box-content"
            });
    }
</div>
