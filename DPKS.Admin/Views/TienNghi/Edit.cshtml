@using DPKS.Common.Enum
@model DPKS.Model.TienNghi.Request.TienNghiUpdateRequest

<div class="modal-content">
    <form id="modal-form" enctype="multipart/form-data">
        <div class="modal-header">
            <h4 class="modal-title">Cập nhật tiện nghi</h4>
            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>

        <div class="modal-body">
            <div class="form-row">
                <div class="form-group col-md-6">
                    <label asp-for="Name" class="control-label"></label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>
                <div class="form-group col-md-6">
                    <label asp-for="Description" class="control-label"></label>
                    <input asp-for="Description" class="form-control" />
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>
                <div class="form-group col-md-6">
                    <label asp-for="Icon" class="control-label">Biểu tượng</label>
                    <select asp-for="Icon" class="form-control" id="Icon">
                        <option value="">-- Chọn biểu tượng --</option>
                        @foreach (var icon in ViewBag.IconList as List<(string DisplayName, string CssClass)>)
                        {
                            var selected = Model?.Icon == icon.CssClass ? "selected" : "";
                            <option value="@icon.CssClass" selected="@selected">@icon.DisplayName</option>
                        }
                    </select>
                    <span asp-validation-for="Icon" class="text-danger"></span>

                    <div class="mt-3 text-center">
                        <span class="d-block text-muted mb-1">Xem trước biểu tượng:</span>
                        <i id="icon-preview" class="@Model?.Icon" style="font-size: 2.5rem;"></i>
                    </div>
                </div>

            </div>
        </div>

        <div class="modal-footer">
            @Html.AntiForgeryToken()

            @if (!string.IsNullOrEmpty(Model.Id))
            {
                <input type="hidden" name="Id" value="@Model.Id" />
            }
            else
            {
                <input type="hidden" name="Id" value="@ViewBag.Id?.ToString().EncodeId()" />
            }

            <button type="button" class="btn btn-secondary" data-dismiss="modal">Đóng</button>
            <button type="submit" class="btn btn-primary">Lưu</button>
        </div>
    </form>

    @{
        await Html.RenderPartialAsync("_ModalScript", new DPKS.Admin.Models.ModalFormRequest
            {
                FormId = "modal-form",
                UrlSubmit = "/TienNghi/Edit",
                UrlPathLoadData = "/TienNghi/List/",
                LoadDataId = "box-content"
            });
    }
</div>

<script>
    $('#Icon').on('change', function () {
        $('#icon-preview').attr('class', $(this).val());
    });
</script>