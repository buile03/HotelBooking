@{
    Layout = null;
    ViewData["Title"] = "Đổi mật khẩu";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Admin</title>

    <link href="~/vendor/fontawesome-free/css/all.min.css" rel="stylesheet" />
    <link href="~/css/sb-admin-2.min.css" rel="stylesheet" />
    <link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/css/site.css" rel="stylesheet" asp-append-version="true" />
    <link rel="icon" href="~/images/favicon.ico" />
</head>

<body class="bg-gradient-primary">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-xl-10 col-lg-12 col-md-9">
                <div class="card o-hidden border-0 shadow-lg my-5">
                    <div class="card-body p-0">
                        <div class="row">
                            <!-- Hình nền bên trái -->
                            <div class="col-lg-6 d-none d-lg-flex align-items-center justify-content-center bg-light">
                                <img src="~/images/account/changepassword.jpg" class="img-fluid" alt="Login Image" style="max-height: 100%; object-fit: cover;">
                            </div>

                            <!-- Nội dung form -->
                            <div class="col-lg-6">
                                <div class="p-5">
                                    <div class="text-center mb-4">
                                        <h1 class="h4 text-gray-900">Đổi mật khẩu</h1>
                                    </div>

                                    <form asp-action="ChangePassword" method="post" class="user">
                                        <div class="form-group">
                                            <input type="password" name="CurrentPassword" class="form-control form-control-user"
                                                   placeholder="Mật khẩu hiện tại" required />
                                        </div>
                                        <div class="form-group">
                                            <input type="password" name="NewPassword" class="form-control form-control-user"
                                                   placeholder="Mật khẩu mới" required />
                                        </div>
                                        <div class="form-group">
                                            <input type="password" name="ConfirmPassword" class="form-control form-control-user"
                                                   placeholder="Xác nhận mật khẩu mới" required />
                                        </div>
                                        <button type="submit" class="btn btn-primary btn-user btn-block">
                                            Cập nhật mật khẩu
                                        </button>
                                    </form>

                                    <hr />
                                    <div class="text-center">
                                        <a class="small" href="/Account/Login">Quay lại đăng nhập</a>
                                    </div>
                                    <div class="text-center">
                                        <a class="small" href="/">Trang chủ</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- JS -->
    <script src="~/vendor/jquery/jquery.min.js"></script>
    <script src="~/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/vendor/jquery-easing/jquery.easing.min.js"></script>
    <script src="~/js/sb-admin-2.min.js"></script>
</body>
</html>
