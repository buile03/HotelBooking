@{
    var fullName = User.FindFirst("FullName")?.Value;
    var userName = User.Identity.IsAuthenticated ? User.Identity.Name : "Chưa đăng nhập";
    var photoName = User.FindFirst("PhotoName")?.Value ?? "user.png";
    var displayName = !string.IsNullOrWhiteSpace(fullName) ? fullName :
                      !string.IsNullOrWhiteSpace(userName) ? userName : "Khách";
}
<!-- Topbar -->
<nav class="navbar navbar-expand navbar-light bg-white topbar mb-4 static-top shadow justify-content-between">

    <!-- Sidebar Toggle (Mobile) -->
    <button id="sidebarToggleTop" class="btn btn-link d-md-none rounded-circle mr-2">
        <i class="fa fa-bars"></i>
    </button>

    <!-- Left: DateTime -->
    <div class="text-gray-600 small text-darkơ
40+0.+68
;lg
fw-bold">
        <span id="datetimeDisplay"></span>
    </div>

    <!-- Right Section -->
    <ul class="navbar-nav ml-auto align-items-center">

        <!-- Language Switch -->
        <li class="nav-item dropdown no-arrow mx-1">
            <a class="nav-link dropdown-toggle" href="#" id="langDropdown" role="button" data-toggle="dropdown">
                <i class="fas fa-globe"></i> VN
            </a>
            <div class="dropdown-menu dropdown-menu-right shadow animated--grow-in" aria-labelledby="langDropdown">
                <a class="dropdown-item" href="#">🇻🇳 Tiếng Việt</a>
                <a class="dropdown-item" href="#">🇺🇸 English</a>
            </div>
        </li>

        <!-- Notifications -->
        <li class="nav-item dropdown no-arrow mx-1">
            <a class="nav-link dropdown-toggle" href="#" id="alertsDropdown" role="button" data-toggle="dropdown">
                <i class="fas fa-bell fa-fw"></i>
                <span class="badge badge-danger badge-counter">3</span>
            </a>
            <div class="dropdown-menu dropdown-menu-right shadow animated--grow-in" aria-labelledby="alertsDropdown">
                <h6 class="dropdown-header">Thông báo</h6>
                <a class="dropdown-item d-flex align-items-center" href="#">
                    <div class="mr-3">
                        <div class="icon-circle bg-primary">
                            <i class="fas fa-file-alt text-white"></i>
                        </div>
                    </div>
                    <div>
                        <span class="font-weight-bold">Đơn đặt phòng mới!</span>
                        <div class="small text-gray-500">5 phút trước</div>
                    </div>
                </a>
                <a class="dropdown-item text-center small text-gray-500" href="#">Xem tất cả</a>
            </div>
        </li>

        <!-- Dark Mode Toggle -->
        <li class="nav-item mx-1">
            <button class="btn btn-light" id="toggleDarkMode" title="Chuyển giao diện">
                <i class="fas fa-moon"></i>
            </button>
        </li>

        <!-- Divider -->
        <div class="topbar-divider d-none d-sm-block"></div>

        <!-- User Info -->
        <li class="nav-item dropdown no-arrow">
            <a class="nav-link dropdown-toggle" href="#" id="userDropdown" role="button" data-toggle="dropdown">
                <span class="mr-2 d-none d-lg-inline text-gray-600 small">@displayName</span>
                <img class="img-profile rounded-circle" src="~/images/user/@photoName" asp-append-version="true" />
            </a>
            <div class="dropdown-menu dropdown-menu-right shadow animated--grow-in" aria-labelledby="userDropdown">
                @if (User.Identity.IsAuthenticated)
                {
                    <a class="dropdown-item" href="/Profile">
                        <i class="fas fa-user fa-sm fa-fw mr-2 text-gray-400"></i>
                        Thông tin cá nhân
                    </a>
                    <div class="dropdown-divider"></div>
                    <form asp-action="Logout" asp-controller="Account" method="post" class="dropdown-item m-0 p-0">
                        <button type="submit" class="btn btn-link text-left dropdown-item">
                            <i class="fas fa-sign-out-alt fa-sm fa-fw mr-2 text-gray-400"></i>
                            Đăng xuất
                        </button>
                    </form>
                }
                else
                {
                    <a class="dropdown-item" href="/Account/Login">
                        <i class="fas fa-sign-in-alt fa-sm fa-fw mr-2 text-gray-400"></i>
                        Đăng nhập
                    </a>
                    <a class="dropdown-item" href="/Account/Register">
                        <i class="fas fa-user-plus fa-sm fa-fw mr-2 text-gray-400"></i>
                        Đăng ký
                    </a>
                }
            </div>
        </li>
    </ul>
</nav>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        setInterval(() => {
            const now = new Date();
            const display = document.getElementById("datetimeDisplay");
            if (display) {
                display.textContent =
                    now.toLocaleDateString('vi-VN') + ' ' + now.toLocaleTimeString('vi-VN');
            }
        }, 1000);
    });

            document.getElementById("toggleDarkMode").addEventListener("click", function () {
                document.body.classList.toggle("bg-dark");
                document.body.classList.toggle("text-white");
            });

</script>
