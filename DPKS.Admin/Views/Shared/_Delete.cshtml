@model DPKS.Admin.Models.FormRequest
<div class="modal-content border-0 shadow">
    <form id="modal-form-delete" enctype="multipart/form-data">
        <div class="modal-header bg-light border-bottom-0">
            <h5 class="modal-title font-weight-bold text-danger">
                <i class="fas fa-exclamation-triangle mr-2"></i> @Model.Title
            </h5>
            <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>

        <div class="modal-body">
            @{
                await Html.RenderPartialAsync("_Message");
            }

            <div class="text-center">
                <p class="lead text-muted mb-3">@Model.Caption</p>
            </div>
        </div>

        <div class="modal-footer border-top-0">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                <i class="fas fa-times"></i> Đóng
            </button>
            <button type="submit" class="btn btn-danger">
                <i class="fas fa-trash-alt"></i> Xác nhận xóa
            </button>
        </div>
    </form>

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial", new DPKS.Admin.Models.FormRequest()
            {
                FromId = "modal-form-delete",
                Url = Model.Url,
                UrlBack = Model.UrlBack,
                IsLoadPage = Model.IsLoadPage,
                CallFuntion = Model.CallFuntion
            });
    }
</div>
