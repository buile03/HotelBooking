@model DPKS.Model.User.PasswordVm.ChangePasswordVm

@{
    ViewData["Title"] = "Đổi mật khẩu";
    Layout = null; // Nếu cần đồng bộ hoàn toàn như Login
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <title>Đổi mật khẩu - Đặt Phòng Khách Sạn</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" type="text/css" href="/admin/css/font-awesome.min.css">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&display=swap&subset=vietnamese">

    <link rel="icon" href="~/images/favicon.ico" />
</head>
<body>
    <div class="container-fluid vh-100">
        <div class="row h-100">
            <div class="col-md-8 d-none d-md-block p-0">
                <img src="https://images.unsplash.com/photo-1600585154340-be6161a56a0c?ixlib=rb-4.0.3&auto=format&fit=crop&w=1920&q=80"
                     class="img-fluid h-100 object-fit-cover"
                     alt="Phòng khách sạn sang trọng">
            </div>

            <div class="col-md-4 d-flex align-items-center justify-content-center bg-light" style="min-height: 100vh;">
                <div class="w-100 p-3" style="max-width: 400px; background-color: #ffffff; border-radius: 16px; box-shadow: 0 8px 24px rgba(0,0,0,0.1);">
                    <h2 class="text-center mb-4" style="font-weight: 600;">Đổi mật khẩu</h2>

                    @if (ViewBag.Message != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            @ViewBag.Message
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    <p class="text-muted mb-4 text-center">Vui lòng nhập mật khẩu hiện tại và mật khẩu mới của bạn.</p>

                    <form asp-action="ChangePassword" method="post">
                        <div class="mb-3">
                            <label asp-for="CurrentPassword" class="form-label">Mật khẩu hiện tại</label>
                            <input asp-for="CurrentPassword" type="password" class="form-control rounded-3" placeholder="Nhập mật khẩu hiện tại" />
                            <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="NewPassword" class="form-label">Mật khẩu mới</label>
                            <input asp-for="NewPassword" type="password" class="form-control rounded-3" placeholder="Nhập mật khẩu mới" />
                            <span asp-validation-for="NewPassword" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="ConfirmPassword" class="form-label">Xác nhận mật khẩu</label>
                            <input asp-for="ConfirmPassword" type="password" class="form-control rounded-3" placeholder="Xác nhận mật khẩu mới" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>

                        <button type="submit" class="btn btn-primary w-100 py-2 rounded-3 text-white shadow-sm">
                            Cập nhật mật khẩu
                        </button>
                    </form>

                    <div class="text-center mt-4">
                        <a asp-action="Profile" class="text-decoration-none text-primary">Quay lại trang cá nhân</a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Scripts -->
    <script src="/admin/js/bootstrap/bootstrap.min.js"></script>
    <script src="/admin/js/plugin/jquery-validate/jquery.validate.min.js"></script>
    <script src="/admin/js/plugin/masked-input/jquery.maskedinput.min.js"></script>
</body>
</html>

<style>
    body {
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        background: linear-gradient(to right, #f8f9fa, #e9ecef);
    }

    input:focus, button:focus {
        box-shadow: 0 0 0 0.2rem rgba(13, 110, 253, 0.25);
        outline: none;
    }

    button:hover {
        opacity: 0.9;
        transition: 0.3s ease-in-out;
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
