@model DPKS.Model.User.PasswordVm.ResetPasswordVm

@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <title>Đặt lại mật khẩu - Đặt Phòng Khách Sạn</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&display=swap&subset=vietnamese">
    <link rel="icon" href="~/images/favicon.ico" />
</head>
<body>
    <div class="container-fluid vh-100">
        <div class="row h-100">
            <!-- Hình ảnh bên trái -->
            <div class="col-md-8 d-none d-md-block p-0">
                <img src="https://images.unsplash.com/photo-1600585154340-be6161a56a0c?ixlib=rb-4.0.3&auto=format&fit=crop&w=1920&q=80"
                     class="img-fluid h-100 object-fit-cover"
                     alt="Phòng khách sạn sang trọng">
            </div>

            <!-- Form bên phải -->
            <div class="col-md-4 d-flex align-items-center justify-content-center bg-light">
                <div class="w-100 p-4" style="max-width: 400px; background-color: #ffffff; border-radius: 16px; box-shadow: 0 8px 24px rgba(0,0,0,0.1);">
                    <h2 class="text-center mb-4" style="font-weight: 600;">Đặt lại mật khẩu</h2>

                    @if (ViewBag.Message != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            @ViewBag.Message
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    <p class="text-muted mb-3 text-center">Vui lòng nhập email, mã khôi phục và mật khẩu mới.</p>

                    <form asp-action="ResetPassword" method="post" novalidate>

                        <div class="mb-3">
                            <label asp-for="ResetCode" class="form-label">Mã khôi phục</label>
                            <input asp-for="ResetCode" class="form-control rounded-3" placeholder="Nhập mã khôi phục" />
                            <span asp-validation-for="ResetCode" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="NewPassword" class="form-label">Mật khẩu mới</label>
                            <input asp-for="NewPassword" type="password" class="form-control rounded-3" placeholder="Nhập mật khẩu mới" />
                            <span asp-validation-for="NewPassword" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="ConfirmPassword" class="form-label">Xác nhận mật khẩu</label>
                            <input asp-for="ConfirmPassword" type="password" class="form-control rounded-3" placeholder="Xác nhận mật khẩu mới" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>

                        <button type="submit" class="btn btn-success w-100 py-2 rounded-3 shadow-sm">
                            <i class="bi bi-check-circle me-2"></i>Đặt lại mật khẩu
                        </button>
                    </form>

                    <div class="text-center mt-4">
                        <a asp-action="Login" class="text-decoration-none text-primary">← Quay lại đăng nhập</a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Bootstrap JS -->
    <script src="/admin/js/bootstrap/bootstrap.min.js"></script>

    <!-- Validation -->
    <script src="/admin/js/plugin/jquery-validate/jquery.validate.min.js"></script>
    <script src="/admin/js/plugin/masked-input/jquery.maskedinput.min.js"></script>
</body>
</html>

<style>
    body {
        font-family: 'IBM Plex Sans', sans-serif;
        background: linear-gradient(to right, #f8f9fa, #e9ecef);
    }

    input:focus, button:focus {
        box-shadow: 0 0 0 0.2rem rgba(25, 135, 84, 0.25);
        outline: none;
    }

    button:hover {
        opacity: 0.9;
        transition: 0.3s ease-in-out;
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
