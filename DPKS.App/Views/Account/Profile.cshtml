@model DPKS.Model.User.UpdateProfileVm
@{
    ViewData["Title"] = "Thông tin cá nhân";
}

<div class="container mt-5">
    <h2 class="mb-4">Cập nhật thông tin cá nhân</h2>

    @if (ViewBag.Message != null)
    {
        <div class="alert alert-success">@ViewBag.Message</div>
    }

    <form asp-action="Profile" method="post" enctype="multipart/form-data">
        @Html.HiddenFor(m => m.UserId)

        <div class="mb-3">
            <label asp-for="UserName" class="form-label"></label>
            <input asp-for="UserName" class="form-control" />
            <span asp-validation-for="UserName" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="FullName" class="form-label"></label>
            <input asp-for="FullName" class="form-control" />
            <span asp-validation-for="FullName" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Email" class="form-label"></label>
            <input asp-for="Email" class="form-control" readonly />
        </div>

        <div class="mb-3">
            <label asp-for="QuocGiaId" class="form-label">Quốc gia</label>
            <select asp-for="QuocGiaId" class="form-select"
                    asp-items="@(ViewBag.QuocGiaList != null ? new SelectList(ViewBag.QuocGiaList, "Value", "Text") : new List<SelectListItem>())">
            </select>
            <span asp-validation-for="QuocGiaId" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="TinhId" class="form-label">Tỉnh/Thành phố</label>
            <select asp-for="TinhId" class="form-select"
                    asp-items="@(ViewBag.TinhList != null ? new SelectList(ViewBag.TinhList, "Value", "Text") : new List<SelectListItem>())">
            </select>

            <span asp-validation-for="TinhId" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label class="form-label">Ảnh đại diện</label><br />
            @if (!string.IsNullOrEmpty(Model.PhotoName))
            {
                <img src="~/images/Users/@Model.PhotoName" alt="Avatar" class="img-thumbnail mb-2" style="max-height: 150px;" />
            }
            <input type="file" name="avatarFile" class="form-control" />
        </div>

        <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
