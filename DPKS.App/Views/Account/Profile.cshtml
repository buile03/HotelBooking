@model DPKS.Model.User.UpdateProfileVm

@{
    ViewData["Title"] = "Profile";
    ViewData["PageTitle"] = "Thông tin người dùng";
}
<div class="container-fluid py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-10 col-xl-8">
            <!-- Profile Header Card -->
            <div class="card border-0 shadow-lg mb-4">
                <div class="card-body p-5">
                    <div class="row align-items-center">
                        <div class="col-md-3 text-center mb-4 mb-md-0">
                            <div class="position-relative d-inline-block">
                                @if (!string.IsNullOrEmpty(Model.PhotoName))
                                {
                                    <img src="~/images/user/user.png"
                                         alt="Avatar"
                                         class="rounded-circle border border-4 border-light shadow-lg"
                                         style="width: 120px; height: 120px; object-fit: cover;">
                                }
                                else
                                {
                                    <div class="rounded-circle bg-primary d-flex align-items-center justify-content-center border border-4 border-light shadow-lg"
                                         style="width: 120px; height: 120px;">
                                        <i class="fas fa-user text-white fa-3x"></i>
                                    </div>
                                }
                                <button type="button" class="btn btn-primary btn-sm rounded-circle position-absolute bottom-0 end-0 border border-2 border-white"
                                        data-bs-toggle="modal" data-bs-target="#changeAvatarModal">
                                    <i class="fas fa-camera"></i>
                                </button>
                            </div>
                        </div>
                        <div class="col-md-9">
                            <h2 class="fw-bold text-dark mb-2">
                                @(!string.IsNullOrEmpty(Model.FullName) ? Model.FullName : "Chưa cập nhật tên")
                            </h2>
                            <p class="text-muted mb-3">
                                <i class="fas fa-envelope me-2"></i>
                                @User.Identity.Name
                            </p>
                            <div class="d-flex flex-wrap gap-2">
                                <span class="badge bg-success-subtle text-success px-3 py-2 rounded-pill">
                                    <i class="fas fa-check-circle me-1"></i>
                                    Tài khoản đã xác thực
                                </span>
                                <span class="badge bg-info-subtle text-info px-3 py-2 rounded-pill">
                                    <i class="fas fa-crown me-1"></i>
                                    Thành viên
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Profile Form Card -->
            <div class="card border-0 shadow-lg">
                <div class="card-header bg-transparent border-0 p-4">
                    <h4 class="fw-bold text-dark mb-0">
                        <i class="fas fa-user-edit me-2 text-primary"></i>
                        Thông tin cá nhân
                    </h4>
                </div>
                <div class="card-body p-5">
                    @if (!string.IsNullOrEmpty(ViewBag.Message))
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            <i class="fas fa-check-circle me-2"></i>
                            @ViewBag.Message
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    @using (Html.BeginForm("Profile", "Account", FormMethod.Post, new { enctype = "multipart/form-data", @class = "needs-validation", novalidate = "novalidate" }))
                    {
                        @Html.AntiForgeryToken()
                        @Html.HiddenFor(m => m.UserId)
                        @Html.HiddenFor(m => m.PhotoName)

                        <div class="row g-4">
                            <!-- Full Name -->
                            <div class="col-md-6">
                                <label class="form-label fw-semibold text-dark">
                                    <i class="fas fa-user me-2 text-primary"></i>
                                    Họ và tên
                                </label>
                                @Html.TextBoxFor(m => m.FullName, new
                                    {
                                        @class = "form-control form-control-lg border-2 rounded-3",
                                        placeholder = "Nhập họ và tên đầy đủ",
                                        required = "required"
                                    })
                                @Html.ValidationMessageFor(m => m.FullName, "", new { @class = "invalid-feedback d-block" })
                            </div>

                            <!-- Email (Read-only) -->
                            <div class="col-md-6">
                                <label class="form-label fw-semibold text-dark">
                                    <i class="fas fa-envelope me-2 text-primary"></i>
                                    Email
                                </label>
                                <input type="email" class="form-control form-control-lg border-2 rounded-3 bg-light"
                                       value="@User.Identity.Name" readonly>
                                <div class="form-text">
                                    <i class="fas fa-info-circle me-1"></i>
                                    Email không thể thay đổi
                                </div>
                            </div>

                            @* <!-- Country --> *@
                            @* <div class="col-md-6"> *@
                            @*     <label class="form-label fw-semibold text-dark"> *@
                            @*         <i class="fas fa-globe me-2 text-primary"></i> *@
                            @*         Quốc gia *@
                            @*     </label> *@
                            @*     @Html.DropDownListFor(m => m.QuocGiaId, *@
                            @*              new SelectList(ViewBag.QuocGiaList, "Id", "TenQuocGia", Model.QuocGiaId), *@
                            @*              "-- Chọn quốc gia --", *@
                            @*              new { @class = "form-select form-select-lg border-2 rounded-3" }) *@
                            @*     @Html.ValidationMessageFor(m => m.QuocGiaId, "", new { @class = "invalid-feedback d-block" }) *@
                            @* </div> *@

                            @* <!-- Province --> *@
                            @* <div class="col-md-6"> *@
                            @*     <label class="form-label fw-semibold text-dark"> *@
                            @*         <i class="fas fa-map-marker-alt me-2 text-primary"></i> *@
                            @*         Tỉnh/Thành phố *@
                            @*     </label> *@
                            @*     @Html.DropDownListFor(m => m.TinhId, *@
                            @*              new SelectList(ViewBag.TinhList, "Id", "TenTinh", Model.TinhId), *@
                            @*              "-- Chọn tỉnh/thành phố --", *@
                            @*              new { @class = "form-select form-select-lg border-2 rounded-3" }) *@
                            @*     @Html.ValidationMessageFor(m => m.TinhId, "", new { @class = "invalid-feedback d-block" }) *@
                            @* </div> *@

                            <!-- Additional Info Section -->
                            <div class="col-12">
                                <hr class="my-4">
                                <h5 class="fw-bold text-dark mb-3">
                                    <i class="fas fa-info-circle me-2 text-primary"></i>
                                    Thông tin bổ sung
                                </h5>
                            </div>

                            <!-- Phone Number -->
                            <div class="col-md-6">
                                <label class="form-label fw-semibold text-dark">
                                    <i class="fas fa-phone me-2 text-primary"></i>
                                    Số điện thoại
                                </label>
                                <input type="tel" class="form-control form-control-lg border-2 rounded-3"
                                       placeholder="Nhập số điện thoại">
                            </div>

                            <!-- Date of Birth -->
                            <div class="col-md-6">
                                <label class="form-label fw-semibold text-dark">
                                    <i class="fas fa-calendar me-2 text-primary"></i>
                                    Ngày sinh
                                </label>
                                <input type="date" class="form-control form-control-lg border-2 rounded-3">
                            </div>

                            <!-- Address -->
                            <div class="col-12">
                                <label class="form-label fw-semibold text-dark">
                                    <i class="fas fa-home me-2 text-primary"></i>
                                    Địa chỉ
                                </label>
                                <textarea class="form-control form-control-lg border-2 rounded-3"
                                          rows="3" placeholder="Nhập địa chỉ chi tiết"></textarea>
                            </div>
                        </div>

                        <!-- Action Buttons -->
                        <div class="row mt-5">
                            <div class="col-12">
                                <div class="d-flex gap-3 justify-content-end">
                                    <button type="button" class="btn btn-outline-secondary btn-lg px-4 rounded-3">
                                        <i class="fas fa-times me-2"></i>
                                        Hủy bỏ
                                    </button>
                                    <button type="submit" class="btn btn-primary btn-lg px-4 rounded-3">
                                        <i class="fas fa-save me-2"></i>
                                        Lưu thay đổi
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Account Settings Card -->
            <div class="card border-0 shadow-lg mt-4">
                <div class="card-header bg-transparent border-0 p-4">
                    <h4 class="fw-bold text-dark mb-0">
                        <i class="fas fa-cog me-2 text-primary"></i>
                        Cài đặt tài khoản
                    </h4>
                </div>
                <div class="card-body p-5">
                    <div class="row g-4">
                        <div class="col-md-12">
                            <div class="d-flex align-items-center justify-content-between p-3 bg-light rounded-3">
                                <div>
                                    <h6 class="fw-semibold mb-1">Đổi mật khẩu</h6>
                                    <small class="text-muted">Cập nhật mật khẩu bảo mật</small>
                                </div>
                                <a href="@Url.Action("ChangePassword", "Account")" class="btn btn-outline-primary">
                                    <i class="fas fa-key me-1"></i>
                                    Đổi
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Change Avatar Modal -->
<div class="modal fade" id="changeAvatarModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold">Thay đổi ảnh đại diện</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body pt-2">
                <form enctype="multipart/form-data">
                    <div class="text-center mb-4">
                        <div class="position-relative d-inline-block">
                            <img id="preview-avatar" src="@(!string.IsNullOrEmpty(Model.PhotoName) ? "~/uploads/avatars/" + Model.PhotoName : "/images/default-avatar.png")"
                                 alt="Preview" class="rounded-circle border border-3 border-light shadow"
                                 style="width: 100px; height: 100px; object-fit: cover;">
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Chọn ảnh mới</label>
                        <input type="file" class="form-control form-control-lg border-2 rounded-3"
                               accept="image/*" id="avatar-upload">
                        <div class="form-text">
                            <i class="fas fa-info-circle me-1"></i>
                            Định dạng: JPG, PNG. Kích thước tối đa: 2MB
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-primary">
                    <i class="fas fa-upload me-1"></i>
                    Cập nhật
                </button>
            </div>
        </div>
    </div>
</div>

<script>
    // Preview avatar when file selected
    document.getElementById('avatar-upload').addEventListener('change', function(e) {
        const file = e.target.files[0];
        if (file) {
            const reader = new FileReader();
            reader.onload = function(e) {
                document.getElementById('preview-avatar').src = e.target.result;
            };
            reader.readAsDataURL(file);
        }
    });

    // Form validation
    (function() {
        'use strict';
        window.addEventListener('load', function() {
            var forms = document.getElementsByClassName('needs-validation');
            var validation = Array.prototype.filter.call(forms, function(form) {
                form.addEventListener('submit', function(event) {
                    if (form.checkValidity() === false) {
                        event.preventDefault();
                        event.stopPropagation();
                    }
                    form.classList.add('was-validated');
                }, false);
            });
        }, false);
    })();

    // Country/Province cascade
    document.querySelector('[name="QuocGiaId"]').addEventListener('change', function() {
        // Load provinces based on selected country
        // Implement AJAX call here
    });
</script>