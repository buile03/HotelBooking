@model DPKS.Common.Result.PagedResult<DPKS.Model.TienNghi.DanhSachTienNghiVm>
@{
    ViewData["Title"] = "Tiện nghi";
    ViewData["PageTitle"] = "Tiện nghi sang trọng";
}

<div class="text-center mb-5">
    <p class="text-muted">Những tiện nghi hiện đại và đầy đủ phục vụ cho kỳ nghỉ tuyệt vời của bạn</p>

    <form method="get" class="row justify-content-center mt-4">
        <div class="col-md-4">
            <input type="text" name="keyword" value="@Model.Keyword" class="form-control" placeholder="Tìm theo tên tiện nghi..." />
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-primary w-100">
                <i class="bi bi-search"></i> Tìm kiếm
            </button>
        </div>
    </form>
</div>

<div class="row g-4">
    @if (!Model.Items.Any())
    {
        <div class="alert alert-warning text-center" role="alert">
            Không có tiện nghi nào để hiển thị.
        </div>
    }
    else
    {
        @foreach (var amenity in Model.Items)
        {
            <div class="col-12 col-sm-6 col-lg-4">
                <div class="card border-0 shadow-lg h-100 rounded-4">
                    <div class="card-body p-4 d-flex flex-column align-items-start">
                        <div class="mb-3 text-primary fs-1">
                            <i class="bi bi-star-fill"></i>
                        </div>
                        <h5 class="card-title fw-bold mb-2">@amenity.Name</h5>
                        <p class="card-text text-muted mb-0">@amenity.Description</p>
                    </div>
                </div>
            </div>
        }
    }
</div>

@if (Model.PageCount > 1)
{
    <nav aria-label="Page navigation" class="mt-5">
        <ul class="pagination justify-content-center">
            <li class="page-item @(Model.PageIndex == 1 ? "disabled" : "")">
                <a class="page-link" href="?pageIndex=@(Model.PageIndex - 1)&pageSize=@Model.PageSize&keyword=@Model.Keyword">Trước</a>
            </li>

            @for (int i = 1; i <= Model.PageCount; i++)
            {
                <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                    <a class="page-link" href="?pageIndex=@i&pageSize=@Model.PageSize&keyword=@Model.Keyword">@i</a>
                </li>
            }

            <li class="page-item @(Model.PageIndex == Model.PageCount ? "disabled" : "")">
                <a class="page-link" href="?pageIndex=@(Model.PageIndex + 1)&pageSize=@Model.PageSize&keyword=@Model.Keyword">Tiếp</a>
            </li>
        </ul>
    </nav>
}

