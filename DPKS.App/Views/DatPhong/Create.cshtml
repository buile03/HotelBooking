@model DPKS.Model.DatPhong.Request.DatPhongCreateRequest

@{
    ViewData["Title"] = "Đặt phòng";
    ViewData["PageTitle"] = "Đặt phòng khách sạn";
}

<div class="container-fluid bg-light min-vh-100 py-5">
    <div class="row justify-content-center">
        <div class="col-xl-8 col-lg-10">
            <div class="card border-0 shadow-lg">
                <div class="card-header bg-gradient text-white text-center py-4" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">

                    <p class="mb-0 opacity-75">Hoàn tất thông tin để xác nhận đặt phòng</p>
                </div>

                <div class="card-body p-5">
                    @if (ViewData.ModelState.ErrorCount > 0)
                    {
                        <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
                            <i class="fas fa-exclamation-triangle me-2"></i>
                            <strong>Có lỗi xảy ra:</strong>
                            <ul class="mb-0 mt-2">
                                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                                {
                                    <li>@error.ErrorMessage</li>
                                }
                            </ul>
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    <form asp-action="Create" method="post" class="needs-validation" novalidate>
                        @Html.AntiForgeryToken()
                        @Html.HiddenFor(m => m.PhongId)
                        @Html.HiddenFor(m => m.UserId)

                        <div class="row g-4">
                            <!-- Thông tin phòng -->
                            <div class="col-12">
                                <div class="bg-light rounded-3 p-4 border-start border-5 border-primary">
                                    <h5 class="text-primary mb-3">
                                        <i class="fas fa-door-open me-2"></i>Thông tin phòng
                                    </h5>
                                    <div class="row">
                                        <div class="col-md-6">
                                            <p class="mb-2"><strong>Mã phòng:</strong> <span class="text-primary">#@Model.PhongId</span></p>
                                        </div>
                                        <div class="col-md-6">
                                            <p class="mb-2"><strong>Loại phòng:</strong> <span class="text-muted">Phòng cao cấp</span></p>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Ngày nhận phòng -->
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input asp-for="NgayNhanPhong"
                                           type="date"
                                           class="form-control form-control-lg border-2"
                                           id="NgayNhanPhong"
                                           min="@DateTime.Now.ToString("yyyy-MM-dd")"
                                           required />
                                    <label for="NgayNhanPhong" class="text-muted">
                                        <i class="fas fa-calendar-plus me-2"></i>Ngày nhận phòng
                                    </label>
                                    <span asp-validation-for="NgayNhanPhong" class="text-danger small"></span>
                                </div>
                            </div>

                            <!-- Ngày trả phòng -->
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input asp-for="NgayTraPhong"
                                           type="date"
                                           class="form-control form-control-lg border-2"
                                           id="NgayTraPhong"
                                           min="@DateTime.Now.AddDays(1).ToString("yyyy-MM-dd")"
                                           required />
                                    <label for="NgayTraPhong" class="text-muted">
                                        <i class="fas fa-calendar-minus me-2"></i>Ngày trả phòng
                                    </label>
                                    <span asp-validation-for="NgayTraPhong" class="text-danger small"></span>
                                </div>
                            </div>

                            <!-- Số lượng khách -->
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <select asp-for="SoLuongKhach"
                                            class="form-select form-select-lg border-2"
                                            id="SoLuongKhach"
                                            required>
                                        <option value="">Chọn số lượng khách</option>
                                        <option value="1">1 khách</option>
                                        <option value="2">2 khách</option>
                                        <option value="3">3 khách</option>
                                        <option value="4">4 khách</option>
                                    </select>
                                    <label for="SoLuongKhach" class="text-muted">
                                        <i class="fas fa-users me-2"></i>Số lượng khách
                                    </label>
                                    <span asp-validation-for="SoLuongKhach" class="text-danger small"></span>
                                </div>
                            </div>

                            <!-- Tổng tiền preview -->
                            <div class="col-md-6">
                                <div class="bg-success bg-opacity-10 rounded-3 p-4 border border-success border-opacity-25">
                                    <h6 class="text-success mb-2">
                                        <i class="fas fa-calculator me-2"></i>Tổng chi phí
                                    </h6>
                                    <div class="h4 text-success mb-0" id="tongTienPreview">
                                        Vui lòng chọn ngày
                                    </div>
                                    <small class="text-muted">* Giá có thể thay đổi tùy theo thời gian</small>
                                </div>
                            </div>

                            <!-- Điều khoản -->
                            <div class="col-12">
                                <div class="form-check p-3 bg-light rounded-3">
                                    <input class="form-check-input me-3" type="checkbox" id="acceptTerms" required>
                                    <label class="form-check-label text-muted" for="acceptTerms">
                                        Tôi đồng ý với <a href="#" class="text-decoration-none fw-bold">điều khoản và điều kiện</a>
                                        của khách sạn và xác nhận thông tin đặt phòng là chính xác.
                                    </label>
                                </div>
                            </div>
                        </div>

                        <!-- Buttons -->
                        <div class="row mt-5">
                            <div class="col-12">
                                <div class="d-grid gap-3 d-md-flex justify-content-md-end">
                                    <a href="@Url.Action("Index", "Phong")"
                                       class="btn btn-outline-secondary btn-lg px-5">
                                        <i class="fas fa-arrow-left me-2"></i>Quay lại
                                    </a>
                                    <button type="submit"
                                            class="btn btn-lg px-5 text-white fw-bold"
                                            style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); border: none;">
                                        <i class="fas fa-check-circle me-2"></i>Xác nhận đặt phòng
                                    </button>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>

                <!-- Card footer với thông tin liên hệ -->
                <div class="card-footer bg-light border-0 py-4">
                    <div class="row text-center text-muted">
                        <div class="col-md-4">
                            <i class="fas fa-phone-alt text-primary mb-2"></i>
                            <div><small>Hotline: 1900 1234</small></div>
                        </div>
                        <div class="col-md-4">
                            <i class="fas fa-envelope text-primary mb-2"></i>
                            <div><small>support@hotel.com</small></div>
                        </div>
                        <div class="col-md-4">
                            <i class="fas fa-clock text-primary mb-2"></i>
                            <div><small>Hỗ trợ 24/7</small></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Validation and date calculation
        document.addEventListener('DOMContentLoaded', function() {
            const ngayNhan = document.getElementById('NgayNhanPhong');
            const ngayTra = document.getElementById('NgayTraPhong');
            const soKhach = document.getElementById('SoLuongKhach');
            const tongTienPreview = document.getElementById('tongTienPreview');

            const giaPhong = 500000; // Giá mẫu, có thể lấy từ server

            function updateTongTien() {
                if (ngayNhan.value && ngayTra.value) {
                    const checkIn = new Date(ngayNhan.value);
                    const checkOut = new Date(ngayTra.value);
                    const soDem = Math.ceil((checkOut - checkIn) / (1000 * 60 * 60 * 24));

                    if (soDem > 0 && soDem <= 31) {
                        const tongTien = giaPhong * soDem;
                        tongTienPreview.innerHTML = `${tongTien.toLocaleString('vi-VN')} VNĐ<br><small class="text-muted">(${soDem} đêm × ${giaPhong.toLocaleString('vi-VN')} VNĐ)</small>`;
                    } else {
                        tongTienPreview.textContent = 'Ngày không hợp lệ';
                    }
                }
            }

            // Update minimum checkout date when checkin changes
            ngayNhan.addEventListener('change', function() {
                if (this.value) {
                    const minCheckout = new Date(this.value);
                    minCheckout.setDate(minCheckout.getDate() + 1);
                    ngayTra.min = minCheckout.toISOString().split('T')[0];

                    // Reset checkout if it's before new minimum
                    if (ngayTra.value && new Date(ngayTra.value) <= new Date(this.value)) {
                        ngayTra.value = '';
                    }
                }
                updateTongTien();
            });

            ngayTra.addEventListener('change', updateTongTien);

            // Form validation
            const forms = document.querySelectorAll('.needs-validation');
            Array.from(forms).forEach(form => {
                form.addEventListener('submit', event => {
                    if (!form.checkValidity()) {
                        event.preventDefault();
                        event.stopPropagation();
                    }
                    form.classList.add('was-validated');
                });
            });
        });
    </script>
}