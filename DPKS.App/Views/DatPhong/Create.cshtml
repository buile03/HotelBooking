@model DPKS.Model.DatPhong.Request.DatPhongCreateRequest

@{
    ViewData["Title"] = "Đặt phòng";
}

<h3 class="mb-4">Đặt phòng</h3>

<div class="row">
    <!-- Form đặt phòng bên trái -->
    <div class="col-md-8">
        <form asp-action="Create" method="post" id="bookingForm">
            @Html.HiddenFor(m => m.PhongId)
            <input type="hidden" id="gia1Dem" value="@Model.Gia1Dem" />

            <div class="form-group mb-3">
                <label asp-for="NgayNhanPhong"></label>
                <input asp-for="NgayNhanPhong" class="form-control" type="date" />
                <span asp-validation-for="NgayNhanPhong" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="NgayTraPhong"></label>
                <input asp-for="NgayTraPhong" class="form-control" type="date" />
                <span asp-validation-for="NgayTraPhong" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="SoLuongKhach"></label>
                <input asp-for="SoLuongKhach" class="form-control" type="number" min="1" max="4" />
                <span asp-validation-for="SoLuongKhach" class="text-danger"></span>
            </div>

            <div class="form-group mb-4">
                <label>Phương thức thanh toán</label>
                <div class="d-flex flex-column gap-2">
                    ViewBag.PhuongThucThanhToanList = new List<SelectListItem>
                        {
                        new SelectListItem { Text = "Tiền mặt", Value = "1" },
                        new SelectListItem { Text = "Stripe", Value = "2" },
                        new SelectListItem { Text = "VNPay", Value = "3" },
                        new SelectListItem { Text = "MoMo (Đang bảo trì)", Value = "4", Disabled = true },
                        new SelectListItem { Text = "VNPay (Đang bảo trì)", Value = "5", Disabled = true }
                        };
                </div>
                <span asp-validation-for="PhuongThucThanhToanId" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Xác nhận đặt phòng</button>
        </form>
    </div>

    <!-- Thông tin đặt phòng bên phải -->
    <div class="col-md-4">
        <div class="card border-secondary">
            <div class="card-header bg-light fw-bold">Thông tin đặt phòng</div>
            <div class="card-body">
                <p><strong>Phòng ID:</strong> <span>@Model.</span></p>
                <p><strong>Ngày nhận:</strong> <span id="displayNhanPhong">-</span></p>
                <p><strong>Ngày trả:</strong> <span id="displayTraPhong">-</span></p>
                <p><strong>Số khách:</strong> <span id="displaySoKhach">-</span></p>
                <p><strong>Số đêm:</strong> <span id="displaySoDem">-</span></p>
                <p><strong>Giá 1 đêm:</strong> <span id="displayGia1Dem">@Model.Gia1Dem.ToString("N0") ₫</span></p>
                <hr />
                <h5 class="text-danger"><strong>Tổng tiền:</strong> <span id="displayTongTien">-</span></h5>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function updateSummary() {
            const nhan = document.getElementById("NgayNhanPhong").value;
            const tra = document.getElementById("NgayTraPhong").value;
            const khach = document.getElementById("SoLuongKhach").value;
            const gia1Dem = parseFloat(document.getElementById("gia1Dem").value);

            let soDem = 0;
            let tongTien = 0;

            if (nhan && tra) {
                const d1 = new Date(nhan);
                const d2 = new Date(tra);
                soDem = Math.max(0, Math.round((d2 - d1) / (1000 * 60 * 60 * 24)));
                tongTien = soDem * gia1Dem;
            }

            document.getElementById("displayNhanPhong").textContent = nhan || "-";
            document.getElementById("displayTraPhong").textContent = tra || "-";
            document.getElementById("displaySoKhach").textContent = khach || "-";
            document.getElementById("displaySoDem").textContent = soDem;
            document.getElementById("displayTongTien").textContent = tongTien.toLocaleString("vi-VN") + " ₫";
        }

        document.getElementById("NgayNhanPhong").addEventListener("change", updateSummary);
        document.getElementById("NgayTraPhong").addEventListener("change", updateSummary);
        document.getElementById("SoLuongKhach").addEventListener("input", updateSummary);

        // Tự cập nhật lần đầu
        updateSummary();
    </script>

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
