                                                     aria-valuemax="100"></div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-md-8">
                                    <div class="card border-0 bg-white shadow-sm rounded-3">
                                        <div class="card-body">
                                            <div class="d-flex align-items-start">
