                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div> *@


@model DPKS.Model.Feedback.FeedbackDetailVm
@{
    ViewData["Title"] = "Chi tiết Feedback";
    ViewData["PageTitle"] = "Chi tiết phản hồi";
}

<div class="container my-5">
    <div class="card shadow-sm p-4 mb-4 bg-light rounded-3">
        <div class="row">
            <!-- Thông tin khách hàng -->
            <div class="col-md-6 col-12 mb-3">
                <h5 class="fw-bold mb-3 text-primary">Thông tin khách hàng</h5>
                <p><strong>Tên:</strong> @Model.UserName</p>
                <p><strong>Email:</strong> @Model.Email</p>
            </div>

            <!-- Thông tin đặt phòng -->
            <div class="col-md-6 col-12 mb-3">
                <h5 class="fw-bold mb-3 text-success">Thông tin đặt phòng</h5>
                <p><strong>Loại phòng:</strong> @Model.Type</p>
                <p><strong>Ngày nhận phòng:</strong> @Model.NgayNhanPhong.ToString("dd/MM/yyyy")</p>
                <p><strong>Ngày trả phòng:</strong> @Model.NgayTraPhong.ToString("dd/MM/yyyy")</p>
                <p><strong>Tổng tiền:</strong> @Model.TongTien.ToString("C0", new System.Globalization.CultureInfo("vi-VN"))</p>
            </div>
        </div>
    </div>

    <!-- Đánh giá và bình luận -->
    <div class="card shadow-sm p-4 bg-light rounded-3">
        <h5 class="fw-bold mb-4 text-warning">Đánh giá & Bình luận</h5>
        <div class="row g-3">
            <!-- Điểm đánh giá -->
            <div class="col-md-4 col-12">
                <div class="text-center bg-white rounded-3 p-4 shadow-sm">
                    <div class="display-4 fw-bold text-warning">@Model.DanhGia.0</div>
                    <div>
                        @for (int i = 1; i <= 5; i++)
                        {
                            if (i <= Model.DanhGia)
                            {
                                <i class="fas fa-star text-warning fs-5"></i>
                            }
                            else
                            {
                                <i class="far fa-star text-muted fs-5"></i>
                            }
                        }
                    </div>
                    <small class="text-muted">trên 5 sao</small>

                    <div class="progress mt-3" style="height: 8px;">
                        <div class="progress-bar bg-warning" style="width: @(Model.DanhGia * 20)%"></div>
                    </div>
                </div>
            </div>

            <!-- Nội dung bình luận -->
            <div class="col-md-8 col-12">
                <div class="bg-white rounded-3 p-4 shadow-sm h-100 d-flex flex-column justify-content-between">
                    <p class="fs-6 lh-base mb-3">"@Model.BinhLuan"</p>
                    <div class="text-muted small">
                        <i class="fas fa-clock me-1"></i>@Model.CreateAt.ToString("dd/MM/yyyy HH:mm:ss")
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Nút điều hướng -->
    <div class="text-center mt-4">
        <a href="@Url.Action("Index")" class="btn btn-outline-secondary">Quay lại danh sách</a>
    </div>
</div>
