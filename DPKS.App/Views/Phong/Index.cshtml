@model DPKS.Model.Phong.Request.PhongSearchRequest
@using DPKS.Common.Enum
@using DPKS.App.Extensions
@{
    ViewData["Title"] = "Danh sách phòng";
    ViewData["PageTitle"] = "Danh sách phòng";
    var loaiPhongList = ViewBag.LoaiPhong as List<dynamic> ?? new List<dynamic>();
}

<div class="container-fluid my-4">
    <div class="row">
        <!-- Bộ lọc bên trái (4 ô) -->
        <div class="col-lg-3 col-md-12 filter-sidebar" style="position: sticky; top: 20px;">
            <div class="card shadow-sm p-4 mb-4">
                <h5 class="mb-3">Bộ lọc</h5>
                <form id="filterForm">
                    <input type="hidden" name="PageIndex" value="1" id="pageIndexInput" />
                    <input type="hidden" name="PageSize" value="@Model.PageSize" />

                    <div class="mb-3">
                        <label class="form-label">Giá</label>
                        <select class="form-select" id="sortSelect" name="SortBy">
                            @if (Model.SortBy == "gia-asc")
                            {
                                <option value="gia-asc" selected>Giá: Thấp đến cao</option>
                                <option value="gia-desc">Giá: Cao đến thấp</option>
                            }
                            else if (Model.SortBy == "gia-desc")
                            {
                                <option value="gia-asc">Giá: Thấp đến cao</option>
                                <option value="gia-desc" selected>Giá: Cao đến thấp</option>
                            }
                            else
                            {
                                <option value="gia-asc" selected>Giá: Thấp đến cao</option>
                                <option value="gia-desc">Giá: Cao đến thấp</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Ngày nhận phòng</label>
                        <input type="date" class="form-control" name="NgayNhanPhong" value="@(Model.NgayNhanPhong?.ToString("yyyy-MM-dd"))">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Ngày trả phòng</label>
                        <input type="date" class="form-control" name="NgayTraPhong" value="@(Model.NgayTraPhong?.ToString("yyyy-MM-dd"))">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Số lượng khách</label>
                        <input type="number" class="form-control" name="SoLuongKhach" value="@(Model.SoLuongKhach ?? 1)" min="1" max="10">                      
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Khoảng giá (VNĐ)</label>
                        <div class="d-flex gap-2">
                            <input type="number" class="form-control" name="GiaTu" placeholder="Từ" value="@Model.GiaTu" min="0" step="100000">
                            <input type="number" class="form-control" name="GiaDen" placeholder="Đến" value="@Model.GiaDen" min="0" step="100000">
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Loại phòng</label>
                        <select class="form-select" name="LoaiPhongId">
                            <option value="">Tất cả</option>
                            @foreach (var lp in loaiPhongList)
                            {
                                @if (Model.LoaiPhongId == lp.Id)
                                {
                                    <option value="@lp.Id" selected>@lp.Type</option>
                                }
                                else
                                {
                                    <option value="@lp.Id">@lp.Type</option>
                                }
                            }
                        </select>
                    </div>
                    <!-- Hidden inputs cho advanced filters -->
                    <input type="hidden" name="SortBy" value="@Model.SortBy" id="sortByInput" />
                    @if (Model.TienNghi != null)
                    {
                        foreach (var tn in Model.TienNghi)
                        {
                            <input type="hidden" name="TienNghi" value="@tn" class="tienNghiHidden" />
                        }
                    }
                    <input type="hidden" name="LoaiGiuong" value="@Model.LoaiGiuong" id="loaiGiuongInput" />
                    <input type="hidden" name="LoaiView" value="@Model.LoaiView" id="loaiViewInput" />

                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-primary flex-grow-1" onclick="applyFilters()">Tìm kiếm</button>
                        <button type="button" class="fa fa-list btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#advancedFilterModal"></button>
                    </div>
                    <button type="button" class="btn btn-secondary w-100 mt-2" onclick="resetForm()">Xóa bộ lọc</button>
                </form>
            </div>
        </div>

        <!-- Danh sách phòng bên phải (8 ô) -->
        <div class="col-lg-9 col-md-12">
           

            <!-- Thông báo lỗi -->
            @if (ViewBag.ErrorMessage != null)
            {
                <div class="alert alert-danger" role="alert">
                    @ViewBag.ErrorMessage
                </div>
            }

            <!-- Danh sách phòng -->
            <div id="box-content"></div>
        </div>
    </div>
</div>

<!-- Modal bộ lọc nâng cao -->
<div class="modal fade" id="advancedFilterModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Bộ lọc nâng cao</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label">Tiện nghi</label>
                    <div class="row">
                        @foreach (var tienNghi in ViewBag.TienNghiList ?? new List<string>())
                        {
                            <div class="col-6">
                                @if (Model.TienNghi?.Contains(tienNghi) == true)
                                {
                                    <input type="checkbox" name="TienNghi" value="@tienNghi" id="@tienNghi" checked>
                                }
                                else
                                {
                                    <input type="checkbox" name="TienNghi" value="@tienNghi" id="@tienNghi">
                                }
                                <label for="@tienNghi">@tienNghi</label>
                            </div>
                        }
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label">Loại giường</label>
                    <select class="form-select" name="LoaiGiuong" id="modalLoaiGiuong">
                        <option value="">Tất cả</option>
                        @foreach (enLoaiGiuong giuong in Enum.GetValues(typeof(enLoaiGiuong)))
                        {
                            @if (Model.LoaiGiuong == giuong)
                            {
                                <option value="@((int)giuong)" selected>
                                    @enHelper.GetDescription(giuong)
                                </option>
                            }
                            else
                            {
                                <option value="@((int)giuong)">
                                    @enHelper.GetDescription(giuong)
                                </option>
                            }
                        }
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label">Loại view</label>
                    <select class="form-select" name="LoaiView" id="modalLoaiView">
                        <option value="">Tất cả</option>
                        @foreach (enLoaiView view in Enum.GetValues(typeof(enLoaiView)))
                        {
                            @if (Model.LoaiView == view)
                            {
                                <option value="@((int)view)" selected>
                                    @enHelper.GetDescription(view)
                                </option>
                            }
                            else
                            {
                                <option value="@((int)view)">
                                    @enHelper.GetDescription(view)
                                </option>
                            }
                        }
                    </select>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                <button type="button" class="btn btn-primary" onclick="applyAdvancedFilters()">Áp dụng</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            let element = document.getElementById('box-content');
            let url = '@Url.Action("List", "Phong")' + window.location.search;
            loadContent(url, element);
            // Xử lý thay đổi sort
            $("#sortSelect").on("change", function () {
                document.getElementById('sortByInput').value = this.value;
                applyFilters();
            });

            // Xử lý thay đổi filter
            $("#filterForm input, #filterForm select").not("#sortSelect").on("change", function () {
                applyFilters();

            pageSetUp();
            });
        });



        function applyFilters() {
            // Reset về trang 1 khi filter
            document.getElementById('pageIndexInput').value = 1;
            loadRoomList();
        }

        function applyAdvancedFilters() {
            // Xóa các hidden input cũ
            document.querySelectorAll('.tienNghiHidden').forEach(el => el.remove());

            // Thêm tiện nghi được chọn
            const checkedTienNghi = document.querySelectorAll('#advancedFilterModal input[name="TienNghi"]:checked');
            checkedTienNghi.forEach(checkbox => {
                const input = document.createElement('input');
                input.type = 'hidden';
                input.name = 'TienNghi';
                input.value = checkbox.value;
                input.className = 'tienNghiHidden';
                document.getElementById('filterForm').appendChild(input);
            });

            // Cập nhật loại giường và view
            document.getElementById('loaiGiuongInput').value = document.getElementById('modalLoaiGiuong').value;
            document.getElementById('loaiViewInput').value = document.getElementById('modalLoaiView').value;

            // Đóng modal và apply filter
            $('#advancedFilterModal').modal('hide');
            applyFilters();
        }

        function resetForm() {
            document.getElementById('filterForm').reset();
            document.getElementById('pageIndexInput').value = 1;
            document.getElementById('sortByInput').value = '';
            document.getElementById('loaiGiuongInput').value = '';
            document.getElementById('loaiViewInput').value = '';
            document.querySelectorAll('.tienNghiHidden').forEach(el => el.remove());

            // Reset modal checkboxes
            document.querySelectorAll('#advancedFilterModal input[type="checkbox"]').forEach(cb => cb.checked = false);
            document.getElementById('modalLoaiGiuong').value = '';
            document.getElementById('modalLoaiView').value = '';

            loadRoomList();
        }

        // Hàm để handle pagination clicks
        function changePage(pageIndex) {
            document.getElementById('pageIndexInput').value = pageIndex;
            loadRoomList();
        }
    </script>
}