
@model PagedResult<DPKS.Model.Phong.ThongTinDanhSachPhongVm>
@using DPKS.Common.Enum
@using DPKS.Common.Result
@using DPKS.App.Extensions

<div class="row row-cols-1 row-cols-md-2 g-4">
    @foreach (var phong in Model.Items)
    {
        <div class="col">
            <div class="card h-100 shadow-sm">
                <img src="@(phong.AnhPhong.FirstOrDefault() != null ? "/images/room/" + phong.AnhPhong.FirstOrDefault() : "/images/room/default.png")"
                     class="card-img-top"
                     alt="@phong.SoPhong"
                     style="height: 200px; object-fit: cover;" />
                <div class="card-body">
                    <h5 class="card-title fw-bold pb-3">Số phòng: @phong.SoPhong</h5>
                    <p class="card-text"><strong>Loại phòng:</strong> @phong.Type</p>
                    <p class="card-text"><strong>Giá:</strong> @phong.Gia.ToString("C", new System.Globalization.CultureInfo("vi-VN")) / đêm</p>
                    <p class="card-text"><strong>Sức chứa:</strong> @phong.SoLuongKhach khách</p>
                    <p class="card-text"><strong>Đánh giá:</strong> @string.Concat(Enumerable.Repeat("★ ", phong.DanhGia))</p>
                    <p class="card-text"><strong>Tiện nghi:</strong> @string.Join(", ", phong.TienNghis.Take(3))@(phong.TienNghis.Count > 3 ? "..." : "")</p>
                </div>
                <div class="card-footer bg-white border-0 text-center d-flex justify-content-center gap-2">
                    <a asp-action="Detail" asp-route-id="@phong.PhongId" class="btn btn-outline-primary rounded-pill px-4 shadow-sm">
                        <i class="bi bi-eye"></i> Xem chi tiết
                    </a>
                    <a asp-controller="DatPhong" asp-action="Create" asp-route-id="@phong.PhongId" class="btn btn-primary rounded-pill px-4 shadow-sm">
                        <i class="bi bi-calendar-check"></i> Đặt phòng
                    </a>
                </div>
            </div>
        </div>
    }
</div>

@if (Model.Items.Count == 0)
{
    <div class="text-center py-5">
        <div class="alert alert-info">
            <i class="bi bi-info-circle"></i> Không tìm thấy phòng nào phù hợp với tiêu chí tìm kiếm.
        </div>
    </div>
}

@if (Model.PageCount > 1)
{
    <nav aria-label="Page navigation" class="mt-5 mb-5">
        <ul class="pagination justify-content-center">
            <li class="page-item @(Model.PageIndex == 1 ? "disabled" : "")">
                <a class="page-link" href="?pageIndex=@(Model.PageIndex - 1)&pageSize=@Model.PageSize">Trước</a>
            </li>

            @for (int i = 1; i <= Model.PageCount; i++)
            {
                <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                    <a class="page-link" href="?pageIndex=@i&pageSize=@Model.PageSize">@i</a>
                </li>
            }

            <li class="page-item @(Model.PageIndex == Model.PageCount ? "disabled" : "")">
                <a class="page-link" href="?pageIndex=@(Model.PageIndex + 1)&pageSize=@Model.PageSize">Tiếp</a>
            </li>
        </ul>
    </nav>
}
