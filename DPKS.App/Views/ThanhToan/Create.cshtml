@model DPKS.Model.ThanhToan.Request.ThanhToanCreateRequest
@{
    ViewData["Title"] = "Thanh toán";
    ViewData["PageTitle"] = "Thanh toán phòng";
}

<form asp-action="Create" method="post">
    <input type="hidden" asp-for="DatPhongId" />
    <input type="hidden" asp-for="ThoiDiemThanhToan" />

    <div class="form-group">
        <label asp-for="PhuongThucThanhToanId">Phương thức thanh toán</label>
        <select asp-for="PhuongThucThanhToanId" class="form-control" asp-items="ViewBag.PhuongThucThanhToanList">
            <option value="">-- Chọn phương thức --</option>
        </select>
        <span asp-validation-for="PhuongThucThanhToanId" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Gia">Tổng tiền</label>
        <input asp-for="Gia" class="form-control" readonly />
    </div>

    <button type="submit" class="btn btn-primary">Xác nhận thanh toán</button>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
